---
type Speaking = {
  name: string;
  description: string;
  date: string; // YYYY-MM-DD
  tags?: string[];
  link?: {
    url: string;
    title?: string;
  };
};

const speaking: Speaking[] = [
  {
    name: 'AWS Community Day NCR 2024 – Design & Ops Insights',
    description:
      'Shared my experience as a volunteer designer & community builder — how we planned creatives, attendee journeys, and on-ground experience for AWS Community Day NCR 2024.',
    date: '2024-09-21',
    tags: ['aws', 'community', 'design', 'events'],
    link: {
      url: 'https://www.linkedin.com/in/shekharthathera',
      title: 'View Event Recap',
    },
  },
  {
    name: 'Startup4Nation – Sponsorship & Community Playbook',
    description:
      'Walked through how Startup4Nation connects sponsors with student communities & startup events, including outreach flows, event ops, and sponsor expectations.',
    date: '2024-12-28',
    tags: ['startup4nation', 'sponsorship', 'community'],
    link: {
      url: 'https://www.linkedin.com/in/shekharthathera',
      title: 'View Session',
    },
  },
  {
    name: 'More updating soon',
    description:
      'Updating sessions of 2024 & 2025 soon — currently busy building a startup, designing events, and breaking things in dev.',
    date: '2025-01-01',
    tags: ['procrastination', 'sleeping'],
    link: {
      url: 'https://www.linkedin.com/in/shekharthathera',
      title: 'View Profile',
    },
  },

  // ❌ if you had `{}` here earlier, DELETE it or make it a valid object
];

// Keep only talks that actually have a valid link/url
const validSpeaking = speaking.filter(
  (talk) => talk.link && typeof talk.link.url === 'string'
);

// Sort by most recent date
const sortedSpeaking = [...validSpeaking].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
---

<div class="terminal-speaking max-w-4xl mx-auto mt-8">

  <!-- Terminal header -->
  <div class="terminal-speaking-header">
    <div class="dots">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
    </div>
    <span class="terminal-title">shekhar@portfolio: ~/logs/speaking.log</span>
  </div>

  <!-- Terminal body -->
  <div class="terminal-speaking-body font-mono text-sm text-gray-200">
    <p class="text-green-400 mb-4">
      shekhar@portfolio:~$ <span class="text-white">cat speaking.log</span>
    </p>

    <div class="space-y-6">
      {sortedSpeaking.map((talk) => (
        <div
          class="border-l border-gray-700 pl-4"
          key={talk.name + talk.date}
        >
          <p class="text-xs text-gray-500 mb-1">
            # {talk.date}
          </p>

          <p class="text-base text-cyan-300 font-semibold">
            {talk.name}
          </p>

          <p class="text-gray-400 mt-1">
            {talk.description}
          </p>

          {talk.tags && talk.tags.length > 0 && (
            <p class="mt-2 text-xs text-gray-500">
              tags:{' '}
              {talk.tags.map((tag, idx) => (
                <span key={tag}>
                  <span class="text-emerald-400">#{tag}</span>
                  {idx < talk.tags!.length - 1 ? ' · ' : ''}
                </span>
              ))}
            </p>
          )}

          <p class="mt-2">
            ↳{' '}
            <a
              href={talk.link?.url || '#'}
              title={talk.link?.title || talk.name}
              target="_blank"
              rel="noreferrer"
              class="text-green-400 underline hover:text-green-300"
            >
              {talk.link?.title || 'Open link'}
            </a>
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- Terminal footer -->
  <div class="terminal-speaking-footer">
    <span>shekhar@portfolio</span>
    <span class="dim">
      :: log=speaking.log :: entries={sortedSpeaking.length}
    </span>
  </div>
</div>

<style is:global>
.terminal-speaking {
  background: #020617;
  border-radius: 0.75rem;
  border: 1px solid rgba(148, 163, 184, 0.5);
  box-shadow: 0 18px 35px rgba(0, 0, 0, 0.7);
  overflow: hidden;
}

/* Header */
.terminal-speaking-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 0.5rem 0.9rem;
  background: #020617;
  border-bottom: 1px solid rgba(148, 163, 184, 0.4);
  font-family: monospace;
  font-size: 0.75rem;
  color: #e5e7eb;
}

.terminal-speaking-header .dots {
  display: flex;
  gap: 0.35rem;
  align-items: center;
}

.terminal-speaking-header .dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
}

.terminal-speaking-header .dot.red {
  background: #ef4444;
}
.terminal-speaking-header .dot.yellow {
  background: #eab308;
}
.terminal-speaking-header .dot.green {
  background: #22c55e;
}

.terminal-speaking-header .terminal-title {
  opacity: 0.8;
}

/* Body */
.terminal-speaking-body {
  padding: 1.1rem 1.25rem 1.3rem;
  background: radial-gradient(circle at top left, #020617, #020617);
}

/* Footer */
.terminal-speaking-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.45rem 0.9rem;
  border-top: 1px solid rgba(148, 163, 184, 0.3);
  background: #020617;
  font-family: monospace;
  font-size: 0.7rem;
  color: #9ca3af;
}

.terminal-speaking-footer .dim {
  opacity: 0.7;
}
</style>